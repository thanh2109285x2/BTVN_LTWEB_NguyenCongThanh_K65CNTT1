@{
    ViewData["Title"] = "ProductList";
}

<div class="container my-4">
    <div class="row">
        <div class="col-md-3 mb-4">
            <h5 class="fw-bold text-dark mb-3">DANH MỤC</h5>
            <div class="list-group rounded-0">
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in ViewBag.Categories)
                    {
                        <a href="/san-pham?category=@cat" class="list-group-item list-group-item-action text-secondary py-2">@cat</a>
                    }
                }
            </div>
        </div>

        <div class="col-md-9">
            <h3 class="fw-normal mb-3 text-dark">Danh sách sản phẩm</h3>

            <div class="row row-cols-1 row-cols-md-3 g-3">
                @if (ViewBag.Products != null)
                {
                    foreach (var p in ViewBag.Products)
                    {
                        <div class="col">
                            <div class="card h-100 rounded-0 border p-2">
                                <img src="@p.ImageUrl" class="card-img-top rounded-0" alt="@p.Name" style="height: 260px; object-fit: cover;">
                                <div class="card-body p-2 d-flex flex-column">
                                    <h5 class="card-title fs-5 fw-normal text-dark mb-2">@p.Name</h5>

                                    <p class="card-text small text-dark mb-3 mt-auto">
                                        <span class="text-decoration-line-through me-2">Giá: @p.OldPrice</span>
                                        <span>Giá: @p.NewPrice</span>
                                    </p>

                                    <a href="/san-pham/chi-tiet/id=@p.Id" class="btn btn-success rounded-1 w-100 py-1" style="background-color: #5cb85c; border-color: #4cae4c;">Chi tiết</a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>