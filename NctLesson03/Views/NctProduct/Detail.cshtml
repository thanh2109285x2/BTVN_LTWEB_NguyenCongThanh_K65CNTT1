@{
    ViewData["Title"] = "ProductDetail";
    var product = ViewBag.Product;
}

<div class="container my-4">
    <h3 class="fw-normal mb-4">Chi tiết sản phẩm</h3>

    @if (product != null)
    {
        <div class="row">
            <div class="col-md-4 mb-3">
                <img src="@product.ImageUrl" alt="@product.Name" class="img-fluid border p-1" style="width: 100%; max-height: 380px; object-fit: cover;" />
            </div>

            <div class="col-md-8">
                <h4 class="fw-normal mb-3">Sản phẩm: @product.Name</h4>
                <p class="fs-5 mb-3">
                    Giá gốc: <span class="text-decoration-line-through me-2">@product.OldPrice</span>
                    Giá mới <span class="fw-normal">@product.NewPrice</span>
                </p>

                <h5 class="fw-normal mb-2">Mô Tả:</h5>
                <p class="text-secondary mb-4" style="line-height: 1.6;">
                    @product.Description
                </p>

                <p class="fs-5 mb-2">Trạng thái: @product.Status</p>
                <p class="fs-5 mb-4">Ngày đăng: @product.CreatedDate.ToString("dd/MM/yyyy hh:mm:ss tt")</p>

                <a href="/san-pham" class="btn btn-danger btn-sm rounded-1 px-3">Về danh sách</a>
            </div>
        </div>
    }
</div>