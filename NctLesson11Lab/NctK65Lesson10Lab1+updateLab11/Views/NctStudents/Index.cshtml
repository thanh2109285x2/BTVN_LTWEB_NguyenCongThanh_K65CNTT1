@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}
@model IEnumerable<Student>
<div class="ms-2 mx-2">
    <h1>Student List</h1>
    @await Component.InvokeAsync("Major")
    <form class="d-none d-md-inline-block form-inline ms-auto me-0 me-md-3 my-2 my-md-0">
        <div class="input-group">
            <input id="keyword" class="form-control" name="keyword"
                   type="text" placeholder="Search learner" />
            <button id="btnSearch" class="btn btn-primary" type="button">
                <i class="fas fa-search"></i>
            </button>
        </div>
    </form>
    <div id="content">
        <partial name="LearnerTable" model="Model" />
    </div>
    <a asp-action="Create" class="btn btn-primary">Create New Student</a>
</div>

@section Scripts {
    <script>
        function loadData(mid, keyword, page) {
            var data = { pageIndex: page };
            if (mid) data.mid = mid;
            if (keyword) data.keyword = keyword;

            $.ajax({
                url: '@Url.Action("LearnerFilter", "NctStudents")',
                data: data,
                success: function (response) {
                    $("div#content").html(response);
                }
            });
        }

        $(document).on("click", ".major-item", function () {
            loadData($(this).attr("id"), $("#keyword").val(), 1);
        });

        $(document).on("click", "li.page-btn", function () {
            loadData($(this).data("mid"), $(this).data("keyword"), $(this).data("page"));
        });

        $("#btnSearch").click(function () {
            loadData("", $("#keyword").val(), 1);
        });
    </script>
}