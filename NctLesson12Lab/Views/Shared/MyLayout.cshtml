<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - Admin Dashboard</title>

    <!-- Bootstrap 4 CSS (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />

    <!-- FontAwesome icons -->
    <script src="https://use.fontawesome.com/releases/v5.15.4/js/all.js" crossorigin="anonymous"></script>

    <!-- File CSS tùy chỉnh trong wwwroot/css/styles.css -->
    <link href="~/css/styles.css" rel="stylesheet" />
</head>
<body class="sb-nav-fixed">
    <!-- Begin Top nav -->
    <partial name="_TopNavPartialView" />
    <!-- End Top nav -->

    <div id="layoutSidenav">
        <!-- Begin Left menu -->
        <div id="layoutSidenav_nav">
            @await Component.InvokeAsync("RenderLeftMenu");
        </div>
        <!-- End Left menu -->
        <!-- Begin Right content -->
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4 py-3">
                    @RenderBody()
                </div>
            </main>
            <partial name="_FooterPartialView" />
        </div>
        <!-- End Right content -->
    </div>

    <!-- JS dependencies (jQuery, Popper.js, Bootstrap 4 JS) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- File Script tùy chỉnh trong wwwroot/js/scripts.js -->
    <script src="~/js/scripts.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>