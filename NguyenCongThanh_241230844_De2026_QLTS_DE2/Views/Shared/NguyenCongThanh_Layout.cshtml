<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AssetHub - Quản lý tài sản doanh nghiệp</title>
    <link href="~/css/layout.css" rel="stylesheet" type="text/css" />
    <link href="~/css/style.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Begin Header -->
    <partial name="NguyenCongThanh_Header" />
    <!-- End Header -->
    <!-- Begin Main Content -->
    <main class="main">
    @RenderBody()
    </main>
    <!-- End Main Content -->
    <!-- Begin Footer -->
    <partial name="NguyenCongThanh_Footer" />
    <!-- End Footer -->
    <div class="to-top">&uarr;</div>
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/main.js"></script>
    <script>
        $(document).on("click", ".loai", function (e) {
            e.preventDefault();
                var maloai = $(this).data("maloai");

            $.ajax({
                url: '@Url.Action("TimKiem", "Home")',
                data: { maloai : maloai },
                success: function (response) {
                    $(".TSMoi").html(response);
                }
            });

            $(".loai").removeClass("active");
            $(this).addClass("active");
        });
    </script>

    @await RenderSectionAsync("Scripts", required:false);
</body>
</html>
