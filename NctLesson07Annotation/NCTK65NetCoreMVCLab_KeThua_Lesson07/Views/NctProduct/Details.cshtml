@model NCTK65NetCoreMVCLab03BaiTapTuLam.Models.NctProduct

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>NctProduct</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NctId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NctId)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NctName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NctName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NctImage)
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.NctImage))
            {
                <img src="@Model.NctImage" alt="@Model.NctName" class="img-fluid" />
            }
            else
            {
                @Html.Raw("&ndash;")
            }
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NctPrice)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NctPrice)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NctScalePrice)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NctScalePrice)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NctDescription)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NctDescription)
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.NctId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
