@model IEnumerable<NCTK65NetCoreMVCLab03BaiTapTuLam.Models.NctCategory>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NctName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NctName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.NctCategoryId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.NctCategoryId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.NctCategoryId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
