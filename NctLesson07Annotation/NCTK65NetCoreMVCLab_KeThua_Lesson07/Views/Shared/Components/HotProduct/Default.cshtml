@model IEnumerable<NCTK65NetCoreMVCLab03BaiTapTuLam.Models.NctProduct>

<div class="card mb-4 border-primary">
    <div class="card-header bg-primary text-white fw-bold">
        Sản phẩm Hot (Load từ Component)
    </div>
    <div class="card-body">
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card text-center h-100">
                        <img src="@item.NctImage" class="card-img-top p-2" alt="@item.NctName" style="max-height: 160px; object-fit: contain;">
                        <div class="card-body d-flex align-items-center justify-content-center">
                            <h6 class="card-title fs-6 m-0">@item.NctName</h6>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>