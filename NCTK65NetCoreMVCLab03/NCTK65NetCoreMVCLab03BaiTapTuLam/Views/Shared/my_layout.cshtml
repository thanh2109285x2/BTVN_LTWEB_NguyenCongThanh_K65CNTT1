<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DEMO LAB</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/my_layout.css" rel="stylesheet">
    @RenderSection("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-2">
            <div class="container">
                <a class="navbar-brand text-uppercase fw-bold px-3 py-1 text-white"
                   asp-controller="Home" asp-action="Index">DEMO LAB</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-light px-3" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-3" asp-area="" asp-controller="Home" asp-action="About">Giới thiệu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-3" asp-controller="Home" asp-action="Contact">Liên hệ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-3" asp-controller="Home" asp-action="Product">Sản phẩm</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main class="container my-3 flex-grow-1">
        @RenderBody()
    </main>
    <footer class="bg-dark text-white py-4 mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-md-6 mb-3 mb-md-0">
                    <h5 class="text-uppercase fw-bold mb-3">GIỚI THIỆU</h5>
                    <p class="text-secondary small mb-0">
                        241230844
                    </p>
                </div>
                <div class="col-md-6">
                    <h5 class="text-uppercase fw-bold mb-3">LIÊN HỆ</h5>
                    <p class="text-secondary small mb-0">
                        nguyen cong thanh
                    </p>
                </div>
            </div>
        </div>
    </footer>
    @RenderSection("Scripts", required: false)

    <script src="~/js/" asp-append-version="true"></script>
</body>
</html>